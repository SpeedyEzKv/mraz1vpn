# Скопируйте в .env командой: ./scripts/init-env.sh
# Случайные секреты скрипт сгенерирует сам. Вручную нужно вписать только BOT_TOKEN.

DOMAIN=mraz1vpn.ru
BOT_USERNAME=mraz1vpn_bot
BOT_TOKEN=
ADMIN_IDS=8303871384

BOT_WEBHOOK_SECRET=
SESSION_SECRET=
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
SYSTEM_DB_PASSWORD=

# Панель 3x-ui. Логин, пароль и секретный путь генерирует init-env.sh,
# API-токен вписывает scripts/xui-init.sh.
XUI_USERNAME=
XUI_PASSWORD=
XUI_BASE_PATH=
XUI_API_TOKEN=

# Оплата. Пустые ключи — способ оплаты не показывается.
# ЮKassa: личный кабинет → Интеграция → Ключи API (shopId и секретный ключ).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# CryptoBot: @CryptoBot → Crypto Pay → Create App → API Token.
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=false
